node_modules/
dist/
dist-ssr/
*.local

# PNG originales de 2:3. Los assets que se shipean son los .webp de public/art
# (1.4 MB: 40 cartas + los 11 viejos + dorso y tapete) mas los 25 SVG de iconos.
# Los fuentes quedan aca para reprocesar con `python tools/optimize_art.py` sin
# volver a gastar creditos de generacion.
art-source/
fonts-source/

# WAV de audio originales (~11 MB: 2 temas de 32 s + 9 SFX). Lo que se shipea
# son los .ogg de public/audio (0.8 MB, -93%). Igual que art-source/: los
# fuentes quedan para reprocesar con `python tools/build_audio.py` sin volver a
# pedir los archivos.
audio-source/

# Tauri / Rust
src-tauri/target/
# El proyecto Android (`tauri android init`) SI se versiona: ahi vive el puente
# de Google Play Games (Kotlin) y la config de la app. Lo generado de verdad
# (builds, .gradle, local.properties) lo ignoran los .gitignore anidados.
src-tauri/gen/schemas/

# --- Android / Google Play: NUNCA al repo ---
# Una keystore filtrada permite publicar actualizaciones en nombre del
# desarrollador. Google Play App Signing permite (y recomienda) rotarla, pero
# el dano previo ya esta hecho.
*.jks
*.keystore
keystore.properties
*.aab
*.apk
src-tauri/gen/android/keystore.properties
src-tauri/gen/android/app/*.jks

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Artefactos del smoke test (capturas de pantalla)
tools/shots/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Backups locales de assets fuente. NO son data del proyecto: los originales
# viven en art-source/ (ya ignorado) y estos son copias de seguridad para poder
# revertir un asset sin volver a generarlo.
.workbuddy-ai/*.OLD.*
